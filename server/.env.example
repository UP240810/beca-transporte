PORT=4000
NODE_ENV=development

# --- Secretos (OBLIGATORIOS en producción, distintos entre sí) ---
JWT_SECRET=cambia-esto-por-un-valor-secreto-real-en-produccion
QR_SECRET=otro-secreto-distinto-solo-para-firmar-los-qr

# --- CORS ---
# Lista de orígenes del frontend, separados por coma.
# En desarrollo puedes dejarlo vacío (permite cualquier origen).
# En producción, ejemplo:
# CORS_ORIGINS=https://beca.calvillo.gob.mx,https://www.calvillo.gob.mx
CORS_ORIGINS=

# --- Redis (rate limiting compartido entre instancias) ---
# Si se deja vacío, el rate limiting usa memoria local (ok para desarrollo
# o un solo proceso). En producción con varias réplicas conviene Redis.
# Ejemplos:
#   REDIS_URL=redis://localhost:6379
#   REDIS_URL=rediss://default:PASSWORD@host:6379   (Upstash / Railway TLS)
REDIS_URL=

# --- Correo (Resend) ---
# Si se deja vacío, los correos se imprimen en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM=Beca de Transporte Calvillo <onboarding@resend.dev>
APP_URL=http://localhost:5173
